{
  "agent_name": "Kimi-K2.5-Frontier",
  "description": "Integration with Kimi-K2.5 and Kimi-K2 frontier models. Access built-in tools and intelligence via the Kimi Platform API.",
  "repositories": [
    "https://github.com/MoonshotAI/Kimi-K2.5",
    "https://github.com/moonshotai/kimi-k2"
  ],
  "api_url": "https://www.kimi.com/ai-models/kimi-k2-5",
  "setup": [
    "pip install moonshotai-frontier"
  ],
  "run": "python -m moonshotai.models --model kimi-k2-5"
}
